{
  "baseUrl": "http://localhost:3000",
  "context": "../AGENTS.md",
  "viewports": {
    "desktop": {
      "width": 1440,
      "height": 900
    },
    "mobile": {
      "width": 390,
      "height": 844,
      "isMobile": true,
      "deviceScaleFactor": 2
    }
  },
  "defaults": {
    "hide": []
  },
  "pages": [
    {
      "id": "home",
      "path": "/",
      "title": "Главная"
    }
  ],
  "components": [
    {
      "id": "header",
      "group": "layout",
      "page": "home",
      "selector": "header"
    },
    {
      "id": "footer",
      "group": "layout",
      "page": "home",
      "selector": "footer"
    }
  ],
  "modals": [
    {
      "id": "example-modal",
      "page": "home",
      "title": "Пример модалки",
      "selector": "[role=dialog]",
      "notes": "Как открывается и закрывается",
      "steps": [
        {
          "click": "[data-open=modal]"
        },
        {
          "waitFor": "[role=dialog]"
        }
      ]
    }
  ]
}

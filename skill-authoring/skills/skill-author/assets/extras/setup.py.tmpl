#!/usr/bin/env python3
"""Зависимости скилла {{name}}.

  python3 scripts/setup.py           проверить реальным импортом; ставить, только если не импортируется
  python3 scripts/setup.py --check   только проверить: код 0 — всё работает, 1 — чего-то не хватает
  python3 scripts/setup.py --force   поставить в venv, даже если уже работает

Проверка — не по путям: сначала модули импортируются тем Python, которым агент запускает скрипты
(пакеты проекта, пользователя, системы), затем — из venv скилла. Не импортируются нигде — ставятся в venv
вне папки скилла (скилл бывает симлинком в git-репо или read-only копией):
  macOS/Linux: ~/.cache/agent-skills/{{name}}    Windows: %LOCALAPPDATA%\\agent-skills\\{{name}}
Переопределить: {{env}}_HOME=<dir>.

Каким Python запускать скрипты, печатает `--check`: текущим, если модули есть у него, иначе — из venv.
"""
import argparse
import os
import subprocess
import sys
import venv
from pathlib import Path

# TODO: пиннованные зависимости — одинаковое поведение на всех машинах
PACKAGES = ["TODO-package==1.0.0"]
# имена модулей для проверки импортом (порядок — как в PACKAGES)
MODULES = ["TODO_module"]
MIN_PYTHON = (3, 9)


def deps_home() -> Path:
    override = os.environ.get("{{env}}_HOME")
    if override:
        return Path(override).expanduser()
    if os.name == "nt":
        base = Path(os.environ.get("LOCALAPPDATA", Path.home() / "AppData" / "Local"))
        return base / "agent-skills" / "{{name}}"
    return Path.home() / ".cache" / "agent-skills" / "{{name}}"


def venv_python(home: Path) -> Path:
    return home / ("Scripts/python.exe" if os.name == "nt" else "bin/python")


def imports_ok(py: Path) -> bool:
    # TODO: если модулю нужен бинарник или сервис — проверь настоящим вызовом, а не только импортом
    code = "; ".join(f"import {m}" for m in MODULES)
    return subprocess.run([str(py), "-c", code], capture_output=True).returncode == 0


def check(home: Path) -> bool:
    for py, where in ((Path(sys.executable), "текущий Python"), (venv_python(home), "venv скилла")):
        if py.exists() and imports_ok(py):
            print(f"  ✓ {', '.join(MODULES)} импортируются — {where}")
            print(f"  python: {py}")
            return True
    print(f"  ✗ {', '.join(MODULES)} не импортируются ни текущим Python, ни из venv ({home})")
    return False


def main() -> int:
    ap = argparse.ArgumentParser(description="Зависимости скилла {{name}}")
    ap.add_argument("--check", action="store_true", help="только проверить, ничего не ставить")
    ap.add_argument("--force", action="store_true", help="поставить в venv, даже если уже работает")
    a = ap.parse_args()

    print("{{name}}: зависимости")
    if sys.version_info < MIN_PYTHON:
        print(f"  ✗ нужен Python {'.'.join(map(str, MIN_PYTHON))}+, сейчас {sys.version.split()[0]}")
        return 1
    home = deps_home()
    ready = check(home)
    if a.check:
        return 0 if ready else 1
    if ready and not a.force:
        print("Готово: всё уже работает, ставить нечего.")
        return 0

    if not venv_python(home).exists():
        print(f"→ venv в {home}")
        venv.create(home, with_pip=True)
    print("→ pip install " + " ".join(PACKAGES))
    r = subprocess.run([str(venv_python(home)), "-m", "pip", "install", "-q", *PACKAGES])
    if r.returncode != 0:
        print("  ✗ pip install упал — см. вывод выше")
        return 1
    return 0 if check(home) else 1


if __name__ == "__main__":
    sys.exit(main())
